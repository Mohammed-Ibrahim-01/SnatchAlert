# Production Environment Variables for PythonAnywhere
# Copy this file to .env on your PythonAnywhere server and customize

# Django Settings
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.pythonanywhere.com,www.yourdomain.com

# Database Configuration (PythonAnywhere MySQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=yourusername$snatchalertdb
DB_USER=yourusername
DB_PASSWORD=your-mysql-password
DB_HOST=yourusername.mysql.pythonanywhere-services.com
DB_PORT=3306

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_DAYS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS Settings (restrict in production)
CORS_ALLOW_ALL_ORIGINS=False

# Email Settings (production SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Frontend URL (production)
FRONTEND_URL=https://yourdomain.com